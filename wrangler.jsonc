{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epita-attendance",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Custom domain (DNS managed on Cloudflare). The workers.dev address redirects here.
  "routes": [{ "pattern": "epita.knhdixh.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API and auth routes go to the Worker; everything else is served as static files.
    "run_worker_first": ["/api/*", "/auth/*", "/feed/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "epita-attendance",
      "database_id": "5144fc5e-ac2b-43bd-b15a-4adc7d28c71a",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI powers the assistant (free daily allocation; prompts are not used for training).
  "ai": { "binding": "AI" },
  "vars": {
    // Assistant limits. Per user per day; owners (AI_OWNER_EMAILS secret) get AI_OWNER_DAILY_LIMIT and are
    // exempt from the shared budget: everyone else together stops at AI_SHARED_DAILY_NEURONS of the
    // 10,000 free daily neurons, so the rest stays available to owners.
    "AI_DAILY_LIMIT": "10",
    "AI_OWNER_DAILY_LIMIT": "15",
    "AI_SHARED_DAILY_NEURONS": "8500",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // Optional: restrict sign-in to one email domain, e.g. "epita.fr". Empty = any Google account.
    "ALLOWED_DOMAIN": "",
    // Requests to any other host (e.g. *.workers.dev) are redirected to this one. Empty = no redirect.
    "CANONICAL_HOST": "epita.knhdixh.com"
  },
  "env": {
    // Design sandbox: `npm run deploy:staging` deploys the Worker "epita-attendance-staging" to
    // epita-staging.knhdixh.com with its own D1 database, so production data and the live site are untouched.
    // routes, vars, d1_databases and ai are not inherited from the top level, so each is set here.
    "staging": {
      "routes": [{ "pattern": "epita-staging.knhdixh.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "epita-attendance-staging",
          "database_id": "f85b96c6-a422-4c92-adad-b0ce396c43b7",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" },
      "vars": {
        // Workers AI neurons are shared across the whole Cloudflare account, and production can't see
        // staging's usage, so staging keeps a small budget to leave production's free allocation alone.
        "AI_DAILY_LIMIT": "5",
        "AI_OWNER_DAILY_LIMIT": "10",
        "AI_SHARED_DAILY_NEURONS": "500",
        "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "ALLOWED_DOMAIN": "",
        "CANONICAL_HOST": "epita-staging.knhdixh.com"
      }
    }
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, or in .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  //   TOKEN_KEY  base64 32-byte key encrypting Google Calendar refresh tokens (openssl rand -base64 32)
  // Local only: DEV_LOGIN=1 in .dev.vars enables a passwordless /auth/dev login.
}
