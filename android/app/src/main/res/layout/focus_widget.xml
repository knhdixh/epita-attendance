<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: next class, what to do next, and the focus timer. Filled in by FocusWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/class_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/class_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next class"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/class_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Open the app once to load your day"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/class_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/class_where"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/todo_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do next"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/todo1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" />
        <TextView android:id="@+id/todo2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" />
        <TextView android:id="@+id/todo3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timer_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_timer_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:id="@+id/timer_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_stat_focus"
            android:tint="@color/widget_accent" />
        <TextView
            android:id="@+id/timer_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Focus"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Chronometer
            android:id="@+id/timer_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:countDown="true"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/timer_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/timer_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Start"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
